# Sao chép file này thành .env (cùng thư mục) rồi điền giá trị.

# Gemini cho trợ lý AI: lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tên model đổi khá nhanh; nếu báo 404 hãy đổi sang model mới trong Google AI Studio
GEMINI_MODEL=gemini-3.5-flash

# Bỏ trống để dùng SQLite tại data/quorum.db. Muốn dùng PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/quorum
DATABASE_URL=

# Thư mục artifacts xuất từ Kaggle (mặc định: artifacts/vn)
ARTIFACT_DIR=

# Chuỗi bí mật để ký token đăng nhập: đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-dung-that

# Địa chỉ frontend được phép gọi API
CORS_ORIGINS=http://localhost:3000

# true: chạy lịch 16:30 ngay trong tiến trình API (không cần mở terminal scheduler riêng)
RUN_SCHEDULER=false

# Ngày bắt đầu tải lịch sử giá lần đầu
PRICE_HISTORY_START=2024-01-01
